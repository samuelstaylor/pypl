&CONTROL
  calculation  = "scf", ! scf, nscf, bands, relax, md, vc-relax, vc-md
  verbosity = 'high',
  restart_mode = 'from_scratch', ! from_scratch, restart
  nstep = 50, ! number of MD or structural optimization steps 
  tstress = .false, ! calculate stress
  tprnfor = .true, ! calculate forces
  max_seconds = 72000, ! = 24 hours
  etot_conv_thr = 1.0D-4, ! conv. threshold on total energy (Ry)
  forc_conv_thr = 0.00039, ! conv. threshold on forces (Ry/Bohr)
!  disk_io = 'none', ! high, medium, low, nowf, none
  pseudo_dir = '/global/cfs/cdirs/m4382/sstaylor/projects/nv_mgo/pseudos', 

/
&SYSTEM
  input_dft = 'pbe0',
  ibrav = 0, ! Bravais-lattice index; if not 0, specify either celldm or A, B, etc.
  nat = 216
  ntyp = 3, ! number of types of atoms in unit cell
  tot_charge = -1, ! total charge of the system
!  starting_magnetization(1) = 0
!  starting_magnetization(2) = 0
!  starting_magnetization(3) = 1
  ecutwfc = 60
  ecutfock = 60
!  ecutwfc = 120.0, ! kinetic energy cutoff (Ry) for w.f.
!  ecutrho = 200.0, ! kinetic energy cutoff (Ry) for charge density and potential
!  nosym = .true,
!  occupations = 'smearing', ! smearing, tetrahedra, tetrahedra_lin, tetrahedra_opt, fixed, from_input
!  smearing = 'gaussian', ! gaussian, mp, mv, fd
!  degauss = 0.001 ! Ry
  nspin = 2, ! 1, 2, 4
  occupations = 'fixed'
  tot_magnetization = 2
  nbnd = 900
  exx_fraction = 0.34,
/
&ELECTRONS
  electron_maxstep = 100 !max number of iterations in an scf step
  conv_thr = 1.0e-7,
  diagonalization = 'david', ! david, cg, ppcg, paro, rmm-davidson, rmm-paro
  startingpot = 'atomic', ! atomic, file
  startingwfc = 'atomic+random', ! atommic, atomic+random, random, file
  tqr = .false, ! real-space algorithm for augmentation charges of USPP and PAWsets
  real_space = .false, ! real-space localization to compute matrix elements
  diago_full_acc = .true. ! diag empty states at same level accuracy as occupied ones

/
&IONS
  ion_positions = 'default',
  ion_dynamics = 'bfgs', !bfgs, damp, fire, verlet, etc.
/
&CELL
  cell_dynamics = 'bfgs',
/
ATOMIC_SPECIES ! mass in amu
Mg  1.00 Mg_ONCV_PBE-1.2.upf   ! masses are irrelevant since no MD
O   1.00 O_ONCV_PBE-1.2.upf 
N   1.00 N_ONCV_PBE-1.2.upf
K_POINTS {gamma}
CELL_PARAMETERS {angstrom}
        12.570000000       0.0000000000        0.0000000000
        0.0000000000       12.570000000        0.0000000000
        0.0000000000       0.0000000000        12.570000000
